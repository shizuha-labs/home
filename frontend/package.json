{
  "name": "shizuha-home-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-route-html.mjs",
    "preview": "vite preview",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:live": "SHIZUHA_LIVE_E2E=1 BASE_URL=https://shizuha.com playwright test tests/e2e/live-homepage-talk.spec.js tests/e2e/live-no-replay-old-reply.spec.js tests/e2e/live-mute-fragment.spec.js tests/e2e/live-silence-after-reply.spec.js tests/e2e/live-voice-replies-off.spec.js tests/e2e/live-trace.spec.js --project=chromium --workers=1",
    "test:e2e:live:qa": "SHIZUHA_LIVE_E2E=1 BASE_URL=https://shizuha.com playwright test tests/e2e/live-no-replay-old-reply.spec.js tests/e2e/live-mute-fragment.spec.js tests/e2e/live-silence-after-reply.spec.js tests/e2e/live-thread-send.spec.js --project=chromium --workers=1",
    "test:e2e:live:spoken": "SHIZUHA_LIVE_E2E=1 SHIZUHA_LIVE_SPOKEN_E2E=1 BASE_URL=https://shizuha.com playwright test tests/e2e/live-spoken-conversation.spec.js --project=chromium",
    "prebuild": "node scripts/check-local-packages.mjs && node scripts/nginxResearchProxy.guardrail.test.mjs"
  },
  "dependencies": {
    "@shizuha/chat": "file:../../packages/shizuha-chat",
    "@shizuha/ui": "file:../../packages/shizuha-ui",
    "clsx": "^2.1.0",
    "lucide-react": "^0.303.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "1.1.18",
    "undici": "7.29.0"
  }
}
