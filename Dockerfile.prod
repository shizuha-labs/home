# =============================================================================
# Production Dockerfile for Shizuha Home
# =============================================================================
# Multi-stage build: Build static files from frontend/ subdir, then serve with nginx
# NO HMR, NO Vite dev server - optimized static files only
#
# Build args (set via docker-compose):
#   VITE_BASE_PATH - e.g., /
#   VITE_API_BASE - e.g., /api
#   FRONTEND_PATH - e.g., shizuha-home (relative to monorepo root)
#
# Context: Monorepo root (to access /packages)
# =============================================================================

# Previous live image. CI passes the currently serving tag so old hashed
# JS/CSS stay in the new image. A rolling deploy otherwise 404s the last
# HTML's stylesheet (unstyled shizuha.com). Default is empty nginx so a
# local build without the registry still works.
ARG PREV_FRONTEND_IMAGE=nginx:alpine
FROM ${PREV_FRONTEND_IMAGE} AS prev-assets

# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /workspace/home/frontend

ARG NPM_CONFIG_REGISTRY=https://registry.npmjs.org
ENV NPM_CONFIG_REGISTRY=${NPM_CONFIG_REGISTRY}
ENV SHIZUHA_PACKAGES_DIR=/workspace/packages

# Build arg for frontend path (relative to monorepo root)
ARG FRONTEND_PATH=home

# Copy shared packages first (for vite.shared.js)
COPY packages/shizuha-ui /workspace/packages/shizuha-ui
COPY packages/shizuha-chat /workspace/packages/shizuha-chat

# Install shared package dependencies (needed for build)
RUN cd /workspace/packages/shizuha-ui && npm ci --omit=dev --replace-registry-host=always
RUN cd /workspace/packages/shizuha-chat && npm ci --omit=dev --replace-registry-host=always

# HIVE-694 (2026-07-12): npm>=7 auto-installs peerDependencies, so the installs
# above plant a NESTED react/react-dom under each package. The vite aliases
# point at package SOURCE, so under vite 6 imports of 'react' from /packages/...
# resolved to those nested copies — TWO reacts in the bundle → hooks dispatcher
# null → "useState of null" crash on shizuha.com. Remove them so the app's own
# react is the only candidate (vite resolve.dedupe is the belt; this is braces).
RUN rm -rf /workspace/packages/shizuha-ui/node_modules/react /workspace/packages/shizuha-ui/node_modules/react-dom \
           /workspace/packages/shizuha-chat/node_modules/react /workspace/packages/shizuha-chat/node_modules/react-dom

# Install dependencies first (better caching)
# Note: shizuha-home has frontend/ subdirectory
# Keep the same reviewed dependency graph used by the frontend test Job.
COPY ${FRONTEND_PATH}/frontend/package.json ${FRONTEND_PATH}/frontend/package-lock.json ./
RUN npm ci --replace-registry-host=always

# Copy source from frontend subdirectory
COPY ${FRONTEND_PATH}/frontend/ .

# Preserve frontend-relative guardrail paths in the same nested source layout.
COPY ${FRONTEND_PATH}/nginx.prod.conf /workspace/home/nginx.prod.conf

# Build args for Vite
ARG VITE_BASE_PATH=/
ARG VITE_API_BASE=/api
ARG VITE_HOME_OPERATOR_USER_IDS=
ARG VITE_HOME_OPERATOR_AGENT=
ENV VITE_BASE_PATH=$VITE_BASE_PATH
ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_HOME_OPERATOR_USER_IDS=$VITE_HOME_OPERATOR_USER_IDS
ENV VITE_HOME_OPERATOR_AGENT=$VITE_HOME_OPERATOR_AGENT
ENV NODE_ENV=production

# Build static files
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine
RUN apk add --no-cache 'expat>=2.8.5-r0'

# Build arg needed again in stage 2
ARG FRONTEND_PATH=home

# Copy custom nginx config (nginx.prod.conf is at shizuha-home root, not frontend/)
COPY ${FRONTEND_PATH}/nginx.prod.conf /etc/nginx/conf.d/default.conf
RUN nginx -t

# Keep the previous release's hashed files, then overlay this build.
COPY --from=prev-assets /usr/share/nginx/html /tmp/prev-html
RUN mkdir -p /usr/share/nginx/html/assets \
 && if [ -d /tmp/prev-html/assets ]; then cp -a /tmp/prev-html/assets/. /usr/share/nginx/html/assets/; fi \
 && rm -rf /tmp/prev-html
COPY --from=builder /workspace/home/frontend/dist /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
